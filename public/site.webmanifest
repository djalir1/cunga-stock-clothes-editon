{
  "name": "Cunga Stock — Clothing Store",
  "short_name": "Cunga Stock",
  "description": "Sales, stock, customers and debts for your clothing shop",
  "id": "/dashboard",
  "start_url": "/dashboard?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0EA5E9",
  "background_color": "#ffffff",
  "categories": ["business", "productivity", "shopping"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New Sale", "short_name": "Sale", "url": "/sales", "icons": [{ "src": "/icon-maskable-192.png", "sizes": "192x192" }] },
    { "name": "Add Item", "short_name": "Add item", "url": "/stock?add=1", "icons": [{ "src": "/icon-maskable-192.png", "sizes": "192x192" }] },
    { "name": "Debts", "short_name": "Debts", "url": "/debts", "icons": [{ "src": "/icon-maskable-192.png", "sizes": "192x192" }] }
  ]
}
